        +InformarErro
        +InformarSucesso
    }

    class CompositeNotificacaoAdapter {
        -adapters
        +Informar
        +InformarErro
        +InformarSucesso
    }

    class ConsoleNotificacaoAdapter {
        +Informar
        +InformarErro
        +InformarSucesso
    }

    class WebNotificacaoAdapter {
        +Informar
        +InformarErro
        +InformarSucesso
    }

    class ReservaNotificacaoAdapter {
        +ExibirDetalhes
    }

    class Reserva {
        +string Id
        +string HospedeNome
        +string TipoQuarto
        +DateTime DataEntrada
        +DateTime DataSaida
        +PacoteHospedagem Pacote
        +decimal ValorTotal
        +bool CheckInRealizado
        +bool CheckOutRealizado
    }

    class PacoteHospedagem {
        +string Nome
        +string Descricao
        +IQuarto Quarto
        +List Refeicoes
        +List Servicos
        +decimal DescontoPercentual
        +CalcularValorTotal
    }

    GerenciadorReservas --> IReservaRepository
    GerenciadorReservas --> IInventarioQuartos
    GerenciadorReservas --> INotificacaoReserva
    GerenciadorReservas --> ReservaNotificacaoAdapter

    IReservaRepository <|.. InMemoryReservaRepository
    IInventarioQuartos <|.. InMemoryInventarioQuartosAdapter
    INotificacaoReserva <|.. CompositeNotificacaoAdapter
    INotificacaoReserva <|.. ConsoleNotificacaoAdapter
    INotificacaoReserva <|.. WebNotificacaoAdapter

    CompositeNotificacaoAdapter o-- ConsoleNotificacaoAdapter
    CompositeNotificacaoAdapter o-- WebNotificacaoAdapter

    InMemoryReservaRepository ..> Reserva
    GerenciadorReservas --> Reserva
    Reserva --> PacoteHospedagem
```

## ============================================
## 3b. DIAGRAMA RESUMIDO (visao por camadas)
## ============================================

```mermaid
flowchart TB
    subgraph apresentacao [Controllers MVC]
        HC[HomeController]
        RC[ReservasController]
    end

    subgraph facade [1 - Facade]
        IRF[IReservaFacade]
        RF[ReservaFacade]
        IRF -.-> RF
    end

    subgraph proxy [3 - Proxy]
        CP[CachingDisponibilidadeProxy]
        VP[GerenciadorReservasProxy]
        GR[GerenciadorReservas]
        CP --> VP --> GR
    end

    subgraph adapter [2 - Adapter]
        REP[InMemoryReservaRepository]
        INV[InMemoryInventarioQuartosAdapter]
        NOT[CompositeNotificacaoAdapter]
    end

    subgraph padroes [Builder e Prototype]
        HS[HotelService]
        HD[HotelDirector]
    end

    subgraph modelos [Models]
        RES[Reserva]
        PAC[PacoteHospedagem]
    end

    HC --> IRF
    RC --> IRF
    RF --> CP
    RF --> HS
    RF --> HD
    GR --> REP
    GR --> INV
    GR --> NOT
    HS --> PAC
    HD --> PAC
    GR --> RES
    RES --> PAC
```

## ============================================
## 4. DIAGRAMA DE SEQUÊNCIA - Criar Reserva (com Facade + Proxies)
## ============================================

```mermaid
sequenceDiagram
    actor Cliente
    participant RC as ReservasController
    participant F as ReservaFacade
    participant CP as CachingDisponibilidadeProxy
    participant VP as GerenciadorReservasProxy
    participant G as GerenciadorReservas
    participant HS as HotelService
    participant HD as HotelDirector
    participant PB as IPacoteHospedagemBuilder
    participant Repo as IReservaRepository

    Cliente->>RC: POST /Criar

    RC->>F: CriarReservaComPacote(...)

    Note over F: Facade: default quarto, prototótipo, builder, director, switch pacote

    F->>HS: ObterPrototipoPorTipo(...)
    HS-->>F: IQuarto
    F->>HS: CriarBuilder(tipoPacote)
    HS-->>F: IPacoteHospedagemBuilder
    F->>HD: ConstruirPacoteXxx(quarto)
    HD->>PB: passos de construção
    PB-->>HD: Build via ObterPacote
    HD-->>F: PacoteHospedagem

    F->>CP: CriarReservaWeb(..., pacote)

    CP->>VP: delega (invalida cache se necessário)
    VP->>VP: valida datas + log
    VP->>G: delega

    G->>G: QuartoDisponivel (usa Repo + Inventário)
    G->>Repo: Adicionar(Reserva)
    Repo-->>G: ok
    G-->>VP: Reserva
    VP-->>CP: Reserva
    CP-->>F: Reserva
    F-->>RC: Reserva
    RC-->>Cliente: Redirect Detalhes
```

## ============================================
## 5. DIAGRAMA DE ESTADOS - Reserva
## ============================================

```mermaid
stateDiagram-v2
    [*] --> Reservada: Criar reserva
    
    Reservada --> CheckInRealizado: Check-in
    Reservada --> Cancelada: Cancelar
    
    CheckInRealizado --> CheckOutRealizado: Check-out
    CheckInRealizado --> Cancelada: Cancelar (com taxa)
    
    CheckOutRealizado --> [*]: Concluída
    Cancelada --> [*]: Encerrada
```

## ============================================
## 6. DIAGRAMA COMPONENTES - Sistema
## ============================================

```mermaid
graph TB
    subgraph "Apresentação"
        V[Views Razor]
        C[Controllers]
    end

    subgraph "Coordenação"
        FAC[IReservaFacade / ReservaFacade]
    end

    subgraph "Proxy IGerenciadorReservas"
        PX1[CachingDisponibilidadeProxy]
        PX2[GerenciadorReservasProxy]
        GR[GerenciadorReservas]
    end

    subgraph "Adapters"
        REP[IReservaRepository]
        INV[IInventarioQuartos]
        NOT[INotificacaoReserva Composite]
    end

    subgraph "Negócio + Padrões existentes"
        HS[HotelService / Prototype]
        BD[Builder + HotelDirector]
        M[Models]
    end

    subgraph "Persistência em memória"
        MEM[(List Reserva + inventário fixo)]
    end

    V --> C
    C --> FAC
    FAC --> PX1
    PX1 --> PX2
    PX2 --> GR
    FAC --> HS
    FAC --> BD
    GR --> REP
    GR --> INV
    GR --> NOT
    REP --> MEM
    INV --> MEM
    BD --> M
    HS --> M
    GR --> M
```

## ============================================
## INSTRUÇÕES DE USO
## ============================================

1. Copie o código entre os delimitadores ```mermaid
2. Cole em: https://mermaid.live/ para visualizar
3. Ou use diretamente no GitHub/GitLab (suportam Mermaid nativamente)
4. Para exportar imagem: No Mermaid Live Editor, clique em "Actions" → "PNG/SVG"

## Dicas:
- TB = Top to Bottom (vertical)
- LR = Left to Right (horizontal)
- <--|> = Herança/Implementação
- --> = Associação/Dependência
- ..> = Uso/Dependência fraca
