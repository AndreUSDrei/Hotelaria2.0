# Diagramas de Classe - Sistema Hotelaria Luxury
# Use estes códigos em: https://mermaid.live/ ou GitHub/GitLab Markdown

## ============================================
## 1. DIAGRAMA BUILDER PATTERN - Completo
## ============================================

```mermaid
classDiagram
    direction TB
    
    class IPacoteHospedagemBuilder {
        <<interface>>
        +DefinirNome(string nome)*
        +DefinirDescricao(string descricao)*
        +SelecionarQuarto(IQuarto quarto)*
        +AdicionarCafeDaManha()*
        +AdicionarAlmoco()*
        +AdicionarJantar()*
        +AdicionarServico(string nome, string descricao, decimal preco)*
        +AplicarDesconto(decimal percentual)*
        +Build() PacoteHospedagem
        +Reset()*
    }
    
    class PacoteRomanticoBuilder {
        -PacoteHospedagem _pacote
        +DefinirNome(string nome)
        +DefinirDescricao(string descricao)
        +SelecionarQuarto(IQuarto quarto)
        +AdicionarCafeDaManha()
        +AdicionarAlmoco()
        +AdicionarJantar()
        +AdicionarServico(string, string, decimal)
        +AplicarDesconto(decimal percentual)
        +Build() PacoteHospedagem
        +Reset()
    }
    
    class PacoteNegociosBuilder {
        -PacoteHospedagem _pacote
        +DefinirNome(string nome)
        +DefinirDescricao(string descricao)
        +SelecionarQuarto(IQuarto quarto)
        +AdicionarCafeDaManha()
        +AdicionarAlmoco()
        +AdicionarJantar()
        +AdicionarServico(string, string, decimal)
        +AplicarDesconto(decimal percentual)
        +Build() PacoteHospedagem
        +Reset()
    }
    
    class PacoteHospedagem {
        +string Nome
        +string Descricao
        +IQuarto Quarto
        +List~Refeicao~ Refeicoes
        +List~ServicoAdicional~ Servicos
        +decimal DescontoPercentual
        +CalcularValorTotal(int dias) decimal
        +ExibirDetalhes()
    }
    
    class HotelDirector {
        -IPacoteHospedagemBuilder _builder
        +HotelDirector(IPacoteHospedagemBuilder builder)
        +ConstruirPacoteRomanticoCompleto(IQuarto quarto)
        +ConstruirPacoteNegociosCompleto(IQuarto quarto)
        +ConstruirPacoteBasico(IQuarto quarto)
        +ConstruirPacoteFimDeSemana(IQuarto quarto)
        +ObterPacote() PacoteHospedagem
    }
    
    class Refeicao {
        +string Nome
        +string Descricao
        +string Horario
        +decimal Preco
        +Exibir()
    }
    
    class ServicoAdicional {
        +string Nome
        +string Descricao
        +decimal Preco
        +Exibir()
    }
    
    IPacoteHospedagemBuilder <|.. PacoteRomanticoBuilder
    IPacoteHospedagemBuilder <|.. PacoteNegociosBuilder
    PacoteRomanticoBuilder ..> PacoteHospedagem : creates
    PacoteNegociosBuilder ..> PacoteHospedagem : creates
    HotelDirector --> IPacoteHospedagemBuilder : uses
    PacoteHospedagem --> Refeicao : contains
    PacoteHospedagem --> ServicoAdicional : contains
```

## ============================================
## 2. DIAGRAMA PROTOTYPE PATTERN - Completo
## ============================================

```mermaid
classDiagram
    direction TB
    
    class IQuarto {
        <<interface>>
        +string Tipo*
        +string Descricao*
        +decimal PrecoBaseDiaria*
        +int Capacidade*
        +List~string~ Comodidades*
        +Clone() IQuarto*
        +ExibirDetalhes()*
    }
    
    class QuartoStandard {
        +string Tipo = "Standard"
        +string Descricao
        +decimal PrecoBaseDiaria = 250
        +int Capacidade = 2
        +List~string~ Comodidades
        +Clone() IQuarto
        +QuartoStandard()
    }
    
    class QuartoLuxo {
        +string Tipo = "Luxo"
        +string Descricao
        +decimal PrecoBaseDiaria = 550
        +int Capacidade = 3
        +List~string~ Comodidades
        +Clone() IQuarto
        +QuartoLuxo()
    }
    
    class Suite {
        +string Tipo = "Suite"
        +string Descricao
        +decimal PrecoBaseDiaria = 1050
        +int Capacidade = 4
        +List~string~ Comodidades
        +Clone() IQuarto
        +Suite()
    }
    
    class HotelService {
        -List~IQuarto~ _prototipos
        +HotelService()
        +ObterPrototiposQuartos() List~IQuarto~
        +ObterPrototipoPorTipo(string tipo) IQuarto
        +CriarBuilder(string tipoPacote) IPacoteHospedagemBuilder
    }
    
    IQuarto <|.. QuartoStandard
    IQuarto <|.. QuartoLuxo
    IQuarto <|.. Suite
    HotelService --> IQuarto : manages prototypes
```

## ============================================
## 3. DIAGRAMA ARQUITETURA ATUAL (completo e validado no Mermaid)
## ============================================
## Facade + Adapter + Proxy + Builder + Prototype
## Cole em https://mermaid.live/ — evite "..." e classes sem metodos no corpo.

```mermaid
classDiagram
    direction TB

    class HomeController {
        -IReservaFacade reservaFacade
        +Index() IActionResult
        +Pacotes() IActionResult
        +VerificarDisponibilidade() IActionResult
    }

    class ReservasController {
        -IReservaFacade reservaFacade
        +Index() IActionResult
        +Criar() IActionResult
        +Detalhes(string id) IActionResult
        +CheckIn(string id) IActionResult
        +CheckOut(string id) IActionResult
    }

    class IReservaFacade {
        <<interface>>
        +CriarReservaComPacote() Reserva
        +ObterPrototiposQuartos() List
        +ObterDisponibilidadeCompleta() Dictionary
        +ObterTodasReservas() List
        +ObterReservaPorId(string id) Reserva
        +RealizarCheckIn(string id) bool
        +RealizarCheckOut(string id) bool
        +ContarReservasAtivas() int
    }

    class ReservaFacade {
        -IGerenciadorReservas gerenciador
        -HotelService hotelService
        +CriarReservaComPacote() Reserva
        +ObterPrototiposQuartos() List
    }

    class HotelService {
        -List prototipos
        +ObterPrototipoPorTipo(string tipo) IQuarto
        +CriarBuilder(string tipoPacote) IPacoteHospedagemBuilder
        +ObterPrototiposQuartos() List
    }

    class HotelDirector {
        -IPacoteHospedagemBuilder builder
        +ConstruirPacoteRomanticoCompleto(IQuarto quarto)
        +ConstruirPacoteNegociosCompleto(IQuarto quarto)
        +ConstruirPacoteBasico(IQuarto quarto)
        +ConstruirPacoteFimDeSemana(IQuarto quarto)
        +ObterPacote() PacoteHospedagem
    }

    class IPacoteHospedagemBuilder {
        <<interface>>
        +DefinirNome(string nome)
        +SelecionarQuarto(IQuarto quarto)
        +Build() PacoteHospedagem
        +Reset()
    }

    class PacoteRomanticoBuilder {
        -PacoteHospedagem pacote
        +Build() PacoteHospedagem
    }

    class PacoteNegociosBuilder {
        -PacoteHospedagem pacote
        +Build() PacoteHospedagem
    }

    class IQuarto {
        <<interface>>
        +string Tipo
        +decimal PrecoBaseDiaria
        +Clone() IQuarto
    }

    class QuartoStandard {
        +Clone() IQuarto
    }

    class QuartoLuxo {
        +Clone() IQuarto
    }

    class Suite {
        +Clone() IQuarto
    }

    class IGerenciadorReservas {
        <<interface>>
        +CriarReservaWeb() Reserva
        +QuartoDisponivel() bool
        +ObterDisponibilidadeCompleta() Dictionary
        +RealizarCheckIn(string id) bool
        +RealizarCheckOut(string id) bool
        +ObterTodasReservas() List
    }

    class CachingDisponibilidadeProxy {
        -IGerenciadorReservas real
        +QuartoDisponivel() bool
        +ObterDisponibilidadeCompleta() Dictionary
        +CriarReservaWeb() Reserva
    }

    class GerenciadorReservasProxy {
        -GerenciadorReservas real
        -ILogger logger
        +CriarReservaWeb() Reserva
        +RealizarCheckIn(string id) bool
        +RealizarCheckOut(string id) bool
    }

    class GerenciadorReservas {
        -IReservaRepository repositorio
        -INotificacaoReserva notificacao
        -IInventarioQuartos inventario
        -ReservaNotificacaoAdapter reservaNotificacao
        +CriarReservaWeb() Reserva
        +QuartoDisponivel() bool
        +RealizarCheckIn(string id) bool
        +RealizarCheckOut(string id) bool
    }

    class IReservaRepository {
        <<interface>>
        +ObterTodas
        +ObterPorId
        +Adicionar
        +ContarConflitos
    }

    class InMemoryReservaRepository {
        -List reservas
        +ObterTodas
        +ObterPorId
        +Adicionar
        +ContarConflitos
    }

    class IInventarioQuartos {
        <<interface>>
        +ObterCapacidadePorTipo
    }

    class InMemoryInventarioQuartosAdapter {
        -Dictionary inventario
        +ObterCapacidadePorTipo
    }

    class INotificacaoReserva {
        <<interface>>
        +Informar
        +InformarErro
        +InformarSucesso
    }

    class ConsoleNotificacaoAdapter {
        +Informar
        +InformarErro
        +InformarSucesso
    }

    class WebNotificacaoAdapter {
        +Informar
        +InformarErro
        +InformarSucesso
    }

    class CompositeNotificacaoAdapter {
        -adapters
        +CompositeNotificacaoAdapter
        +Informar
        +InformarErro
        +InformarSucesso
    }

    class ReservaNotificacaoAdapter {
        +ExibirDetalhes
    }

    class Reserva {
        +string Id
        +string HospedeNome
        +string TipoQuarto
        +DateTime DataEntrada
        +DateTime DataSaida
        +PacoteHospedagem Pacote
        +decimal ValorTotal
        +bool CheckInRealizado
        +bool CheckOutRealizado
    }

    class PacoteHospedagem {
        +string Nome
        +string Descricao
        +IQuarto Quarto
        +List Refeicoes
        +List Servicos
        +decimal DescontoPercentual
        +CalcularValorTotal
        +ExibirDetalhes
    }

    HomeController --> IReservaFacade
    ReservasController --> IReservaFacade
    IReservaFacade <|.. ReservaFacade
    ReservaFacade --> IGerenciadorReservas
    ReservaFacade --> HotelService
    ReservaFacade ..> HotelDirector
    ReservaFacade ..> IPacoteHospedagemBuilder

    IGerenciadorReservas <|.. CachingDisponibilidadeProxy
    IGerenciadorReservas <|.. GerenciadorReservasProxy
    IGerenciadorReservas <|.. GerenciadorReservas
    CachingDisponibilidadeProxy --> GerenciadorReservasProxy
    GerenciadorReservasProxy --> GerenciadorReservas

    GerenciadorReservas --> IReservaRepository
    GerenciadorReservas --> IInventarioQuartos
    GerenciadorReservas --> INotificacaoReserva
    GerenciadorReservas --> ReservaNotificacaoAdapter

    IReservaRepository <|.. InMemoryReservaRepository
    IInventarioQuartos <|.. InMemoryInventarioQuartosAdapter
    INotificacaoReserva <|.. ConsoleNotificacaoAdapter
    INotificacaoReserva <|.. WebNotificacaoAdapter
    INotificacaoReserva <|.. CompositeNotificacaoAdapter
    CompositeNotificacaoAdapter o-- ConsoleNotificacaoAdapter
    CompositeNotificacaoAdapter o-- WebNotificacaoAdapter

    IReservaRepository ..> Reserva
    GerenciadorReservas --> Reserva
    Reserva --> PacoteHospedagem

    HotelService --> IQuarto
    IQuarto <|.. QuartoStandard
    IQuarto <|.. QuartoLuxo
    IQuarto <|.. Suite
    HotelDirector --> IPacoteHospedagemBuilder
    IPacoteHospedagemBuilder <|.. PacoteRomanticoBuilder
    IPacoteHospedagemBuilder <|.. PacoteNegociosBuilder
    PacoteRomanticoBuilder ..> PacoteHospedagem
    PacoteNegociosBuilder ..> PacoteHospedagem
    PacoteHospedagem --> IQuarto
```

