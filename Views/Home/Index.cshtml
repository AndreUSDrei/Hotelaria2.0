@{
    ViewData["Title"] = "Início";
}

<div class="hero">
    <h1>@ViewBag.Message</h1>
    <p>Este projeto demonstra os padrões de projeto Observer, Strategy e Composite em um sistema de hotelaria MVC.</p>
    
    <div class="patterns-info">
        <h3>Padrões Demonstrados:</h3>
        <ul>
            @foreach (var pattern in ViewBag.Patterns)
            {
                <li><strong>@pattern:</strong> Veja a implementação nas pastas Services/Observer, Services/Strategy e Services/Notifications</li>
            }
        </ul>
    </div>
    
    <a href="~/Reservas/Index" class="btn btn-primary btn-lg">Ver Reservas</a>
    <a href="~/Reservas/Criar" class="btn btn-secondary btn-lg">Criar Nova Reserva</a>
</div>
