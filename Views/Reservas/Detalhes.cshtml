@model Reserva
@{
    ViewData["Title"] = $"Reserva #{Model.Id}";
}

<h1>📋 Reserva #@Model.Id</h1>
<p>Detalhes da reserva demonstrando os padrões Observer, Strategy e Composite.</p>

<div class="reserva-detalhes">
    <div class="card">
        <h3>Informações Gerais</h3>
        <p><strong>Hóspede:</strong> @Model.HospedeNome</p>
        <p><strong>Período:</strong> @Model.DataEntrada.ToString("dd/MM/yyyy") a @Model.DataSaida.ToString("dd/MM/yyyy")</p>
        <p><strong>Quarto:</strong> @Model.TipoQuarto</p>
        <p><strong>Valor Total:</strong> <span class="valor-total">R$ @Model.ValorTotal.ToString("N2")</span></p>
        <p><strong>Status:</strong> <span class="badge badge-info">@Model.Status</span></p>
    </div>

    <div class="card">
        <h3>💳 Pagamento (Strategy Pattern)</h3>
        <p><strong>Método:</strong> @Model.MetodoPagamento</p>
        @if (!string.IsNullOrEmpty(Model.TransacaoId))
        {
            <p><strong>Transação:</strong> @Model.TransacaoId</p>
        }
    </div>

    <div class="card">
        <h3>🔔 Observer Pattern</h3>
        <p>Quando o status muda, os observadores (Recepção, E-mail, Limpeza) são notificados automaticamente.</p>
        <p><strong>Status Atual:</strong> @Model.Status</p>
    </div>

    <div class="card">
        <h3>📦 Composite Pattern</h3>
        <p>Notificações são enviadas através de múltiplos canais (Console e Web) usando o padrão Composite.</p>
    </div>

    <div class="acoes">
        @if (Model.Status == "Confirmada" || Model.Status == "Paga")
        {
            <form method="post" action="~/Reservas/CheckIn/@Model.Id" style="display:inline">
                <button type="submit" class="btn btn-success">✅ Realizar Check-in</button>
            </form>
        }
        else if (Model.Status == "Check-in")
        {
            <form method="post" action="~/Reservas/CheckOut/@Model.Id" style="display:inline">
                <button type="submit" class="btn btn-warning">👋 Realizar Check-out</button>
            </form>
        }

        <a href="~/Reservas" class="btn btn-secondary">Voltar</a>
    </div>
</div>