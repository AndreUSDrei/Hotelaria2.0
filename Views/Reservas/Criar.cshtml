@{
    ViewData["Title"] = "Nova Reserva";
}

<h1>📝 Nova Reserva</h1>
<p class="subtitle">Crie uma reserva para demonstrar os padrões Observer, Strategy e Composite.</p>

<form method="post" class="form-reserva">
    <div class="form-group">
        <label>Nome do Hóspede</label>
        <input type="text" name="hospedeNome" class="form-control" required />
    </div>

    <div class="form-row">
        <div class="form-group">
            <label>Data de Entrada</label>
            <input type="date" name="dataEntrada" class="form-control" required 
                   min="@DateTime.Now.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-group">
            <label>Data de Saída</label>
            <input type="date" name="dataSaida" class="form-control" required 
                   min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" />
        </div>
    </div>

    <div class="form-group">
        <label>Tipo de Quarto</label>
        <select name="tipoQuarto" class="form-control" required id="tipoQuarto">
            <option value="" disabled selected>Selecione um quarto...</option>
            @foreach (var tipo in ViewBag.TiposQuarto)
            {
                var preco = SistemaHotelaria.Models.TipoQuarto.ObterPrecoDiario(tipo);
                <option value="@tipo" data-preco="@preco">@tipo - R$ @preco:N2/dia</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label>Valor Total (calculado automaticamente)</label>
        <div class="valor-calculado">
            <span id="valorTotal">R$ 0,00</span>
            <small id="detalhesCalculo">Selecione as datas e o tipo de quarto</small>
        </div>
    </div>

    <div class="pagamento-section">
        <h4>💳 Forma de Pagamento (Strategy Pattern)</h4>
        <p class="pagamento-hint">Escolha o método de pagamento - cada um é uma estratégia diferente.</p>

        <div class="pagamento-grid">
            @foreach (var metodo in ViewBag.MetodosPagamento)
            {
                <label class="pagamento-option">
                    <input type="radio" name="metodoPagamento" value="@metodo.ToLower()" 
                           @(metodo == "Pix" ? "checked" : "") />
                    <span class="pagamento-card">
                        <strong>@metodo</strong>
                    </span>
                </label>
            }
        </div>
    </div>

    <button type="submit" class="btn btn-primary btn-lg">Criar Reserva</button>
    <a href="~/Reservas" class="btn btn-secondary">Cancelar</a>
</form>

<style>
    .subtitle {
        color: #666;
        margin-bottom: 2rem;
    }
    
    .pagamento-section {
        margin-top: 2rem;
        margin-bottom: 1.5rem;
        padding: 1.5rem;
        background: linear-gradient(135deg, #16213E08 0%, #C9A96212 100%);
        border-left: 4px solid #1A1A2E;
        border-radius: 8px;
    }

    .pagamento-section h4 {
        color: #1A1A2E;
        margin-bottom: 0.4rem;
    }

    .pagamento-hint {
        color: #666;
        margin-bottom: 1rem;
        font-size: 0.9rem;
    }

    .pagamento-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.8rem;
        margin-bottom: 1rem;
    }

    .pagamento-option {
        cursor: pointer;
    }

    .pagamento-option input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .pagamento-card {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        padding: 1rem;
        background: white;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        transition: all 0.2s ease;
        min-height: 60px;
        justify-content: center;
    }

    .pagamento-option input:checked + .pagamento-card {
        border-color: #C9A962;
        box-shadow: 0 2px 10px rgba(201, 169, 98, 0.25);
        background: #FFFBF2;
    }

    .valor-calculado {
        padding: 1rem;
        background: #f8f9fa;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
    }

    .valor-calculado span {
        font-size: 1.5rem;
        font-weight: bold;
        color: #1A1A2E;
        display: block;
    }

    .valor-calculado small {
        color: #666;
        font-size: 0.85rem;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const dataEntrada = document.querySelector('input[name="dataEntrada"]');
        const dataSaida = document.querySelector('input[name="dataSaida"]');
        const tipoQuarto = document.getElementById('tipoQuarto');
        const valorTotal = document.getElementById('valorTotal');
        const detalhesCalculo = document.getElementById('detalhesCalculo');

        function calcularValor() {
            const entrada = new Date(dataEntrada.value);
            const saida = new Date(dataSaida.value);
            const selectedOption = tipoQuarto.options[tipoQuarto.selectedIndex];
            const precoDiario = parseFloat(selectedOption?.dataset.preco) || 0;

            if (entrada && saida && saida > entrada && precoDiario > 0) {
                const dias = Math.ceil((saida - entrada) / (1000 * 60 * 60 * 24));
                const total = precoDiario * dias;
                valorTotal.textContent = `R$ ${total.toFixed(2)}`;
                detalhesCalculo.textContent = `${dias} diária(s) × R$ ${precoDiario.toFixed(2)}/dia`;
            } else {
                valorTotal.textContent = 'R$ 0,00';
                detalhesCalculo.textContent = 'Selecione as datas e o tipo de quarto';
            }
        }

        dataEntrada.addEventListener('change', calcularValor);
        dataSaida.addEventListener('change', calcularValor);
        tipoQuarto.addEventListener('change', calcularValor);
    });
</script>
